{
  "workbench.editorAssociations": {
    "*.drawio.xml": "drawSlidesCode.textEditor"
  },
  "files.associations": {
    "*.drawio.xml": "drawio"
  },
  "drawSlidesCode.slides": true,
  "drawSlidesCode.colors": {
    // The colours of this deck, the one place where they are defined.  The draw.io editor of VS Code
    // defines them for the formulas of every page and names them in its colour picker, and the build
    // writes into each page the ones that its formulas use.  A formula names a colour as in
    // \textcolor{dpgreen}{F}, and a shape takes it from the picker.  Each name is letters alone.  Each
    // colour is #RRGGBB, which the VS Code extension and the build give MathJax in the model RGB.

    // Text and lines.
    "black": "#000000",
    "white": "#FFFFFF",
    // The grey of secondary text, of arrows and of the outlines of diagrams.  It takes the place of
    // the grey of CSS in \textcolor{gray}, so formulas and shapes share one grey.
    "gray": "#8B959E",
    // The colour of the markers of the lists and of the outline, which drawSlidesCode.listStyles names.
    "accent": "#004D80",

    // Panels, from light to dark: panellight, panel and paneldark fill boxes, and rule draws the
    // outline of a box.
    "panellight": "#F4F5F6",
    "panel": "#EEF0F2",
    "paneldark": "#DCDFE3",
    "rule": "#C8CDD2",

    // The colours of the co-design decks of the author: red for a loss or a resource, green for a
    // gain or a functionality, blue for a specification, each with the tints that fill a region.
    // dpred, dpgreen and specificationcolor keep the values of the LaTeXiT preamble of those decks.
    "dpred": "#B20000",
    "dpredlight": "#FBEAEA",
    "dpgreen": "#008000",
    "dpgreenmid": "#9CCF9C",
    "dpgreenlight": "#DCEFDC",
    "specificationcolor": "#4286F4",
    "specificationlight": "#DAE8FC"
  },
  "drawSlidesCode.templates": [
    "${deckFolder}/templates/*.drawio.xml"
  ],
  "drawSlidesCode.listStyles": {
    "bulleted": [
      {
        "indent": "26.07px",
        "marker": "disclosure-closed",
        "color": "accent",
        "size": "0.7em"
      },
      {
        "indent": "43.93px",
        "marker": "'-  '",
        "color": "accent"
      },
      {
        "indent": "43.93px",
        "marker": "'·  '"
      }
    ]
  },
  "drawSlidesCode.customColorSchemes": [
    [
      {
        "fill": "black",
        "stroke": "black",
        "font": "white"
      },
      {
        "fill": "accent",
        "stroke": "accent",
        "font": "white"
      },
      {
        "fill": "dpred",
        "stroke": "dpred",
        "font": "white"
      },
      {
        "fill": "dpgreen",
        "stroke": "dpgreen",
        "font": "white"
      },
      {
        "fill": "specificationcolor",
        "stroke": "specificationcolor",
        "font": "white"
      },
      {
        "fill": "gray",
        "stroke": "gray",
        "font": "white"
      }
    ],
    [
      {
        "fill": "none",
        "stroke": "black",
        "font": "black"
      },
      {
        "fill": "none",
        "stroke": "accent",
        "font": "accent"
      },
      {
        "fill": "none",
        "stroke": "dpred",
        "font": "dpred"
      },
      {
        "fill": "none",
        "stroke": "dpgreen",
        "font": "dpgreen"
      },
      {
        "fill": "none",
        "stroke": "specificationcolor",
        "font": "specificationcolor"
      },
      {
        "fill": "none",
        "stroke": "gray",
        "font": "gray"
      }
    ]
  ]
}
